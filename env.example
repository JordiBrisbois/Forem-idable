# Copy this file to `.env` and fill values as needed.
# Full self-hosting guide: see SELF_HOSTING.md

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------
# PostgreSQL connection string.
DATABASE_URL=postgres://app:app@localhost:5432/app
# HMAC secret used to hash user ids in operational logs (GDPR anonymisation).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUDIT_HASH_SECRET=change-me-in-production
# Public origin of the app (used by CSRF checks and email links).
APP_BASE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Branding (white-label)
# ---------------------------------------------------------------------------
# Visible product name (single source of truth).
APP_NAME=Mon établissement
# Full browser title. Defaults to `<APP_NAME> - <APP_TITLE_SUFFIX>`.
# APP_TITLE=
# Suffix used when APP_TITLE is not set.
APP_TITLE_SUFFIX=Accompagnement
APP_META_DESCRIPTION=Suivi d'accompagnement et recherche d'offres.
# Short tagline displayed under the logo (hidden when empty).
APP_TAGLINE=
APP_SOURCE_LINK_LABEL=Code source
# Technical identifiers. Usually keep aligned with the app name.
# APP_EXPORT_FILENAME_PREFIX=
# APP_STORAGE_NAMESPACE=
# APP_SESSION_COOKIE_NAME=
# APP_CALENDAR_UID_DOMAIN=
# Optional logo (URL) and monogram fallback.
# APP_LOGO_URL=
# APP_LOGO_MONOGRAM=
# Optional brand color override (any CSS color, e.g. #1d4ed8).
# APP_BRAND_COLOR=

# Controller / copyright shown in the footer and privacy page.
COPYRIGHT_NAME=Mon établissement
PRIVACY_CONTROLLER_NAME=Mon établissement
PRIVACY_CONTACT_EMAIL=
# PRIVACY_SOURCE_URL=
# PRIVACY_LAST_UPDATED_LABEL=

# ---------------------------------------------------------------------------
# Features
# ---------------------------------------------------------------------------
# Enable or disable the Le Forem job-search module entirely.
FEATURE_JOB_SEARCH=true
# Allow public self-registration for beneficiaries.
ALLOW_PUBLIC_REGISTRATION=true
# Default search goal for new users: "internship" or "job".
DEFAULT_SEARCH_GOAL=job

# ---------------------------------------------------------------------------
# Database / infrastructure (optional)
# ---------------------------------------------------------------------------
# Use DB_SSL_MODE=require only for an external database with a valid cert chain.
DB_SSL_MODE=disable
# DB_SSL_CA_PEM=
# DB_SSL_CA_BASE64=
# Redis (optional): distributed rate limiting and messaging pub/sub.
# REDIS_URL=
# Structured timing logs for DB / Redis operations.
SERVER_TIMING_LOGS=false
# Structured audit-style event logs (auth/security/admin/coach).
SERVER_AUDIT_LOGS=true
# Threshold in milliseconds for slow Postgres queries when timing logs are enabled.
DB_SLOW_QUERY_MS=200
# Enable the in-process Scout (OSM company) worker.
SCOUT_WORKER_ENABLED=0

# ---------------------------------------------------------------------------
# Password reset by email (optional)
# ---------------------------------------------------------------------------
PASSWORD_RESET_ENABLED=false
NEXT_PUBLIC_PASSWORD_RESET_ENABLED=false
RESEND_API_KEY=
RESEND_FROM_EMAIL=Mon établissement <no-reply@example.com>
RESEND_REPLY_TO=

# ---------------------------------------------------------------------------
# Job provider: Adzuna (optional, only with FEATURE_JOB_SEARCH)
# ---------------------------------------------------------------------------
ADZUNA_ENABLED=false
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=be

# ---------------------------------------------------------------------------
# Analytics: Umami (optional, disabled by default)
# ---------------------------------------------------------------------------
UMAMI_ENABLED=false
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js
# Comma-separated allowlist of hostnames permitted for the Umami script.
UMAMI_ALLOWED_HOSTS=cloud.umami.is

# ---------------------------------------------------------------------------
# Data retention (optional overrides)
# ---------------------------------------------------------------------------
PASSWORD_RESET_RETENTION_DAYS=7
SEARCH_HISTORY_RETENTION_DAYS=365
DATA_EXPORT_RETENTION_DAYS=7
MESSAGE_RETENTION_MONTHS=18
AUDIT_LOG_RETENTION_MONTHS=24
