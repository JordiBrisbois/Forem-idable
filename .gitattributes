# Normalise line endings so a Windows checkout and the Linux CI produce the
# same bytes: everything is LF in the repository and in the working tree.
* text=auto eol=lf

# Markdown keeps trailing whitespace significant (hard line breaks).
*.md text eol=lf

# Binary assets must never be converted.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.xlsx binary
*.zip binary
